<?xml version="1.0" encoding="utf-8"?>
<!-- Ticketing tab: TabLayout sets the custom view's selected state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/child_tab_selected_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/child_tab_selected_bg" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
