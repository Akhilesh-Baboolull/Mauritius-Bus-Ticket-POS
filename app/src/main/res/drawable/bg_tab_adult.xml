<?xml version="1.0" encoding="utf-8"?>
<!-- Ticketing tab: TabLayout sets the custom view's selected state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/adult_tab_selected_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface_muted" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_border" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
