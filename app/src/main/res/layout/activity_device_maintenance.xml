<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".DeviceMaintenanceActivity">

    <LinearLayout
        android:id="@+id/panel_auth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="100dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_dialog_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            app:srcCompat="@mipmap/ayb_way_logo_foreground" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_circle_blue">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock_24"
                app:tint="#031FB8" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Access Settings"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ui_text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Enter the settings PIN to continue."
            android:textColor="#6B6F76"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_maintenance_password"
            style="@style/SettingsDialogInput"
            android:layout_marginTop="20dp"
            android:hint="PIN"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock_24">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/maintenance_password"
                style="@style/SettingsDialogInputText"
                android:imeOptions="actionDone"
                android:inputType="numberPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_login_lockout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#C62828"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_maintenance_cancel_auth"
                style="@style/SettingsDialogSecondaryButton"
                android:text="Cancel" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_maintenance_unlock"
                style="@style/SettingsDialogPrimaryButton"
                android:backgroundTint="#031FB8"
                android:text="Continue" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/panel_tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_menu_top"
                style="@style/TopBarBackButton"
                android:layout_gravity="start"
                android:text="MENU" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:srcCompat="@mipmap/ayb_way_logo_foreground" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="Settings"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ui_text_title"
                android:textStyle="bold" />

            <!-- App updates -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="Routes &amp; fares"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_master_last_fetch"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_master_counts"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_master_progress"
                style="@style/SettingsStatus" />

            <Button
                android:id="@+id/btn_sync_master"
                style="@style/SettingsButton"
                android:backgroundTint="#031FB8"
                android:text="Sync routes &amp; fares" />

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="Screen brightness" />

            <TextView
                android:id="@+id/tv_brightness_value"
                style="@style/SettingsRow" />

            <SeekBar
                android:id="@+id/seek_brightness"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="255"
                android:min="10" />

            <TextView
                android:id="@+id/tv_brightness_note"
                style="@style/SettingsStatus" />

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="Pending uploads" />

            <TextView
                android:id="@+id/queue_status_text"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_last_upload"
                style="@style/SettingsRow" />

            <TextView
                style="@style/SettingsRow"
                android:text="Failed uploads are kept up to 24 hours and cleared at the start of each new day."
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_upload_progress"
                style="@style/SettingsStatus" />

            <Button
                android:id="@+id/btn_send_pending"
                style="@style/SettingsButton"
                android:backgroundTint="#031FB8"
                android:text="Send pending data now" />

            <Button
                android:id="@+id/btn_view_pending"
                style="@style/SettingsButton"
                android:backgroundTint="#455A64"
                android:text="View pending items" />

            <Button
                android:id="@+id/btn_clear_sync_queue"
                style="@style/SettingsButton"
                android:backgroundTint="#F44336"
                android:text="Clear sync queue" />

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="App updates" />

            <TextView
                android:id="@+id/tv_installed_version"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_last_update_check"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_last_update_result"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_update_available"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_update_progress"
                style="@style/SettingsStatus" />

            <Button
                android:id="@+id/btn_check_updates"
                style="@style/SettingsButton"
                android:backgroundTint="#031FB8"
                android:text="Check for updates" />

            <Button
                android:id="@+id/btn_install_now"
                style="@style/SettingsButton"
                android:backgroundTint="#2B9B06"
                android:text="Install now"
                android:visibility="gone" />

            <!-- Routes and fares -->

            <!-- Pending uploads -->

            <!-- Device status -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="Device status" />

            <TextView
                android:id="@+id/tv_internet"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_battery"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_day_trip"
                style="@style/SettingsRow" />

            <!-- About -->
            <TextView
                style="@style/SettingsSectionTitle"
                android:text="About" />

            <TextView
                android:id="@+id/tv_btm_id"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_company"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_feedback_number"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/tv_server"
                style="@style/SettingsRow" />

            <Button
                android:id="@+id/btn_register"
                style="@style/SettingsButton"
                android:backgroundTint="#031FB8"
                android:text="Register" />

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="Administrator" />

            <Button
                android:id="@+id/btn_audit_log"
                style="@style/SettingsButton"
                android:backgroundTint="#455A64"
                android:text="Audit Log" />

            <Button
                android:id="@+id/btn_exit_kiosk"
                style="@style/SettingsButton"
                android:backgroundTint="#F44336"
                android:text="Admin Access" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_maintenance_back"
                style="@style/FlowSecondaryButton"
                android:layout_marginTop="28dp"
                android:text="MENU" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
