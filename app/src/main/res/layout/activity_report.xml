<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    tools:context=".Report">

    <!-- Top logo -->
    <ImageView
        android:id="@+id/aybway_logo"
        android:layout_width="118dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/aybway_logo"
        android:src="@mipmap/ayb_way_logo_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ① Choose report -->
    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingEnd="@dimen/ui_screen_padding"
        android:paddingBottom="@dimen/ui_screen_padding"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aybway_logo"
        tools:visibility="visible">

        <TextView
            style="@style/FlowTitle"
            android:layout_marginTop="28dp"
            android:text="Reports"
            android:textSize="34sp" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Choose the report you want to print" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trip_report"
            style="@style/MenuTile"
            android:layout_height="110dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#FF9800"
            android:text="@string/detailed_report"
            app:icon="@mipmap/detailed_report_foreground" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/summary_report"
            style="@style/MenuTile"
            android:layout_height="110dp"
            android:layout_marginTop="35dp"
            android:backgroundTint="#3F51B5"
            android:text="@string/summary_report"
            app:icon="@mipmap/summary_report_foreground" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back2"
            style="@style/FlowSecondaryButton"
            android:text="MENU" />
    </LinearLayout>

    <!-- ② Detailed report: choose type -->
    <LinearLayout
        android:id="@+id/trip_report_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingEnd="@dimen/ui_screen_padding"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aybway_logo"
        tools:visibility="gone">

        <TextView
            android:id="@+id/textView11"
            style="@style/FlowTitle"
            android:layout_marginTop="28dp"
            android:text="Detailed Report" />

        <TextView
            android:id="@+id/textView12"
            style="@style/FlowSubtitle"
            android:text="Select which trips to include" />

        <RadioGroup
            android:id="@+id/report_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <RadioButton
                android:id="@+id/radioButton"
                style="@style/ReportOption"
                android:layout_marginTop="0dp"
                android:tag="current_trip"
                android:text="@string/current_trip" />

            <RadioButton
                android:id="@+id/radioButton2"
                style="@style/ReportOption"
                android:tag="all_trips"
                android:text="@string/all_trips" />

            <RadioButton
                android:id="@+id/radioButton3"
                style="@style/ReportOption"
                android:tag="custom_trip"
                android:text="@string/custom_trip" />
        </RadioGroup>
    </LinearLayout>

    <!-- ③ Print actions (shown once a report type is selected) -->
    <LinearLayout
        android:id="@+id/layout_print"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingEnd="@dimen/ui_screen_padding"
        android:paddingBottom="@dimen/ui_screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/selected_trip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="@color/ui_brand"
            android:textSize="@dimen/ui_text_option"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_print"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="@color/ui_success"
            android:text="PRINT REPORT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back1"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="20dp"
            android:text="BACK" />
    </LinearLayout>

    <!-- ③ Back only (before a report type is selected) -->
    <LinearLayout
        android:id="@+id/layout_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingEnd="@dimen/ui_screen_padding"
        android:paddingBottom="@dimen/ui_screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back3"
            style="@style/FlowSecondaryButton"
            android:text="BACK" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
