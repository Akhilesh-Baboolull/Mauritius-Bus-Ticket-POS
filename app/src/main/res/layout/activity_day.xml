<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Day">

    <!-- Top logo -->
    <ImageView
        android:id="@+id/image_logo_top"
        android:layout_width="118dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@mipmap/ayb_way_logo_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ① Start day: choose bus -->
    <LinearLayout
        android:id="@+id/layout_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        tools:visibility="visible">

        <TextView
            android:id="@+id/text_choose_bus"
            style="@style/FlowTitle"
            android:layout_marginTop="28dp"
            android:text="Choose Bus" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Use the arrows to select today's bus" />

        <LinearLayout
            android:id="@+id/bus_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_left"
                style="@style/FlowArrowButton"
                android:contentDescription="Previous bus"
                app:icon="@drawable/ic_chevron_left_24" />

            <TextView
                android:id="@+id/view_stage"
                style="@style/FlowValueBox" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_right"
                style="@style/FlowArrowButton"
                android:contentDescription="Next bus"
                app:icon="@drawable/ic_chevron_right_24" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="@color/flow_confirm_tint"
            android:text="START DAY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="14dp"
            android:text="BACK" />
    </LinearLayout>

    <!-- ② End day: confirm -->
    <LinearLayout
        android:id="@+id/layout_end_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="#FFF0E0">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_24"
                app:tint="#E65100" />
        </FrameLayout>

        <TextView
            android:id="@+id/textView15"
            style="@style/FlowTitle"
            android:layout_marginTop="20dp"
            android:text="End this Day?" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Next you will enter the day's waybill (receipts and expenses)." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_end_day"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="#FF9800"
            android:text="END DAY" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back2"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="14dp"
            android:text="BACK" />
    </LinearLayout>

    <!-- ③ Waybill (day closure) -->
    <LinearLayout
        android:id="@+id/layout_waybill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        tools:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/textView3"
                    style="@style/FlowTitle"
                    android:layout_marginTop="12dp"
                    android:text="Day Closure" />

                <TextView
                    style="@style/FlowSubtitle"
                    android:text="Enter today's other receipts and expenses" />

                <!-- Total receipt (calculated, read-only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_status_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Receipt"
                        android:textColor="#44474E"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs "
                        android:textColor="#2B9B06"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/total_receipt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:enabled="false"
                        android:hint="0"
                        android:inputType="numberDecimal"
                        android:minWidth="60dp"
                        android:singleLine="true"
                        android:textColor="#2B9B06"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Amount fields, two per row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="Other Receipt">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/other_receipt"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="Diesel">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/diesel"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="Wages">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/wages"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="@string/well_meal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/well_meal"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="Maintenance">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/maintenance"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="0dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/WaybillInput"
                        android:hint="Other Expenses">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/other_expenses"
                            style="@style/WaybillInputText"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Actions stay visible above the keyboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back3"
                style="@style/FlowSecondaryButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:text="@string/back"
                android:textSize="19sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_skip"
                style="@style/FlowPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#03A9F4"
                android:text="Skip"
                android:textSize="19sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_waybill"
                style="@style/FlowPrimaryButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#2B9B06"
                android:text="Submit"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
