<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Trip">

    <!-- Top logo -->
    <ImageView
        android:id="@+id/image_logo_top"
        android:layout_width="118dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@mipmap/ayb_way_logo_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ① Begin trip: choose route -->
    <LinearLayout
        android:id="@+id/layout_route"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        tools:visibility="gone">

        <TextView
            style="@style/FlowSubtitle"
            android:layout_marginTop="20dp"
            android:text="Step 1 of 2"
            android:textColor="#031FB8"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_choose_route"
            style="@style/FlowTitle"
            android:layout_marginTop="4dp"
            android:text="Choose Route"
            android:textSize="34sp" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Use the arrows to select the route for this trip" />

        <LinearLayout
            android:id="@+id/route_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_left"
                style="@style/FlowArrowButton"
                android:contentDescription="Previous route"
                app:icon="@drawable/ic_chevron_left_24" />

            <TextView
                android:id="@+id/view_route"
                style="@style/FlowValueBox"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:minHeight="88dp"
                android:singleLine="false"
                android:textSize="28sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_right"
                style="@style/FlowArrowButton"
                android:contentDescription="Next route"
                app:icon="@drawable/ic_chevron_right_24" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="@color/flow_confirm_tint"
            android:text="NEXT" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="14dp"
            android:text="BACK" />
    </LinearLayout>

    <!-- ② Begin trip: choose direction -->

    <!-- ③ Stop trip: confirm -->
    <LinearLayout
        android:id="@+id/layout_direction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        app:layout_constraintVertical_bias="1.0"
        tools:visibility="gone">

        <TextView
            style="@style/FlowSubtitle"
            android:layout_marginTop="20dp"
            android:text="Step 2 of 2"
            android:textColor="#031FB8"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_choose_direction"
            style="@style/FlowTitle"
            android:layout_marginTop="4dp"
            android:text="Choose Direction"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Tap the direction this bus is travelling" />

        <LinearLayout
            android:id="@+id/direction_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/direction1"
                style="@style/FlowPrimaryButton"
                android:layout_height="wrap_content"
                android:backgroundTint="#3F51B5"
                android:minHeight="104dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/direction2"
                style="@style/FlowPrimaryButton"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#3F51B5"
                android:minHeight="104dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textSize="24sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit_direction"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="#2B9B06"
            android:text="START TRIP" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back3"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="14dp"
            android:text="BACK" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_end_trip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_logo_top"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="#FFF0E0">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning_24"
                app:tint="#E65100" />
        </FrameLayout>

        <TextView
            android:id="@+id/textView14"
            style="@style/FlowTitle"
            android:layout_marginTop="20dp"
            android:text="End this Trip?"
            android:textSize="34sp" />

        <TextView
            style="@style/FlowSubtitle"
            android:text="Ticketing stops for this trip once it is ended." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_end_trip"
            style="@style/FlowPrimaryButton"
            android:backgroundTint="#FF9800"
            android:text="STOP TRIP" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back2"
            style="@style/FlowSecondaryButton"
            android:layout_marginTop="14dp"
            android:text="BACK" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
