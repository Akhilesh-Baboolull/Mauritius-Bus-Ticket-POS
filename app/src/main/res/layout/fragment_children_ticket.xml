<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_surface"
    android:orientation="vertical">

    <!-- Fares (buttons are added by the fragment) + tariff list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/bg_fare_panel_child"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/fare_row1"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp" />

        <LinearLayout
            android:id="@+id/fare_row2"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp" />

        <LinearLayout
            android:id="@+id/fare_row3"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_see_tariffs"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="#1bff00"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tariff"
            android:textColor="#000000"
            android:textSize="@dimen/ui_text_tile"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- Boarding stage -->
    <LinearLayout
        android:id="@+id/stage_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_left"
            style="@style/FlowArrowButton"
            android:contentDescription="Previous stage"
            app:icon="@drawable/ic_chevron_left_24" />

        <TextView
            android:id="@+id/view_stage"
            style="@style/FlowValueBox" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_right"
            style="@style/FlowArrowButton"
            android:contentDescription="Next stage"
            app:icon="@drawable/ic_chevron_right_24" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_print"
        style="@style/FlowPrimaryButton"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#FF0101"
        android:text="@string/issue_ticket"
        android:textSize="@dimen/ui_text_tile" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_calculator"
            style="@style/FlowPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#009688"
            android:contentDescription="Calculator"
            android:text=""
            app:icon="@drawable/calculator_icon_foreground"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="108dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_menu"
            style="@style/FlowSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="MENU" />
    </LinearLayout>

    <!-- Shift total: hold the eye to reveal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_status_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shift total"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/ui_text_subtitle" />

        <TextView
            android:id="@+id/total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/hidden_amount"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ui_text_tile"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_view_amount"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/amount_visibility"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/baseline_remove_red_eye_24_black" />
    </LinearLayout>

</LinearLayout>
